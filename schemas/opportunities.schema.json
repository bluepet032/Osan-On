{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osan-on.local/schemas/opportunities.schema.json",
  "title": "오산온 benefits payload",
  "type": "object",
  "required": ["schema_version", "generated_at", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "source_name", "source_url", "organizer", "status", "summary", "primary_type", "field_tags", "audience_tags", "first_seen_at", "last_seen_at", "sources", "date_kind", "relevance"],
        "properties": {
          "id": { "type": "string", "minLength": 8 },
          "title": { "type": "string", "minLength": 1 },
          "source_name": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "organizer": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 60, "maxLength": 180 },
          "status": { "enum": ["upcoming", "open", "urgent", "today", "closed", "ongoing", "unknown"] },
          "date_kind": { "enum": ["exact", "ongoing", "first_come", "budget", "unknown", "inquiry"] },
          "primary_type": { "enum": ["cash", "in_kind", "service", "voucher", "loan", "reduction", "other"], "description": "지원 형태" },
          "domain": { "enum": ["living", "housing", "childcare", "jobs", "health", "admin", "pregnancy", "care", "culture", "agriculture"], "description": "혜택 분야 탭(정부24 서비스분야)" },
          "jurisdiction": { "enum": ["osan", "gyeonggi", "national"], "description": "소관: 오산시, 경기도, 중앙행정기관" },
          "conditions": {
            "description": "정부24 지원조건. null이면 조건 정보 없음",
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["codes", "age_min", "age_max"],
                "properties": {
                  "codes": { "type": "array", "items": { "type": "string", "pattern": "^JA[0-9]{4}$" } },
                  "age_min": { "type": ["integer", "null"] },
                  "age_max": { "type": ["integer", "null"] }
                }
              }
            ]
          },
          "field_tags": { "type": "array", "items": { "type": "string" } },
          "audience_tags": { "type": "array", "items": { "type": "string" } },
          "first_seen_at": { "type": "string", "format": "date-time" },
          "last_seen_at": { "type": "string", "format": "date-time" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_id", "source_name", "source_url", "kind", "priority"],
              "properties": {
                "source_id": { "type": "string", "minLength": 1 },
                "source_name": { "type": "string", "minLength": 1 },
                "source_url": { "type": "string", "format": "uri" },
                "kind": { "type": "string", "minLength": 1 },
                "priority": { "type": "integer" }
              }
            }
          },
          "relevance": {
            "type": "object",
            "required": ["score", "reasons", "decision"],
            "properties": {
              "score": { "type": "integer", "minimum": 0, "maximum": 100 },
              "reasons": { "type": "array", "items": { "type": "string" } },
              "decision": { "enum": ["publish", "review", "exclude"] }
            }
          }
        },
        "not": { "anyOf": [{ "required": ["classification_inputs"] }, { "required": ["body_text"] }] },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
