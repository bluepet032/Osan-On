rules_version = '2';

// Each user can only touch their own documents, and only with the fields and sizes the
// site writes (see src/personal.tsx and src/account.tsx). Keep these in sync with the app.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function shortString(value, max) {
      return value is string && value.size() <= max;
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Same UIDs as the repository variable VITE_ADMIN_UIDS (src/admin.ts); update both together.
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['sfsE5vAcqfNhnw6ilBGnKyx04k23'];
    }

    // Wrong-information reports (src/reports.ts). Any signed-in visitor may send one as
    // themselves, stamped with the server time; the admin reads them and deletes them once
    // handled, and a sender can find and delete their own when deleting their account.
    match /reports/{reportId} {
      allow read, delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['opportunityId', 'title', 'sourceUrl', 'reason', 'note', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reason in ['period', 'target', 'link', 'other']
        && request.resource.data.opportunityId is string
        && request.resource.data.opportunityId.size() >= 1
        && shortString(request.resource.data.opportunityId, 100)
        && shortString(request.resource.data.title, 200)
        && shortString(request.resource.data.sourceUrl, 2000)
        && shortString(request.resource.data.note, 500)
        && request.resource.data.createdAt == request.time;
    }

    match /users/{uid} {
      // The app never writes this document; it only removes it when deleting the account.
      allow read, delete: if isOwner(uid);

      match /favorites/{favoriteId} {
        function validFavorite(data) {
          return data.keys().hasOnly(['item', 'remindersEnabled', 'resultDate', 'note', 'updatedAt'])
            && data.item is map
            && data.remindersEnabled is bool
            && shortString(data.resultDate, 10)
            && shortString(data.note, 500)
            && shortString(data.updatedAt, 40);
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validFavorite(request.resource.data);
        allow update: if isOwner(uid)
          && validFavorite(request.resource.data)
          && changesOnly(['remindersEnabled', 'resultDate', 'note', 'updatedAt']);
      }

      match /keywords/{keywordId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['word', 'createdAt'])
          && request.resource.data.word is string
          && request.resource.data.word.size() >= 1
          && request.resource.data.word.size() <= 60
          && shortString(request.resource.data.createdAt, 40);
      }

      // Eligibility answers (src/profile.ts). One document, always written whole with setDoc.
      match /profile/{profileId} {
        function codeList(value, max) {
          return value is list && value.size() <= max;
        }

        function validProfile(data) {
          return profileId == 'main'
            && data.keys().hasOnly(['gender', 'age', 'income', 'traits', 'household', 'updatedAt'])
            && (!('gender' in data) || data.gender in ['male', 'female'])
            && (!('age' in data) || (data.age is int && data.age >= 0 && data.age <= 120))
            && (!('income' in data) || data.income in ['JA0201', 'JA0202', 'JA0203', 'JA0204', 'JA0205'])
            && (!('traits' in data) || codeList(data.traits, 30))
            && (!('household' in data) || codeList(data.household, 20))
            && shortString(data.updatedAt, 40);
        }

        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validProfile(request.resource.data);
      }

      match /notifications/{notificationId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['type', 'title', 'message', 'opportunityId', 'sourceUrl', 'date', 'read', 'createdAt'])
          && request.resource.data.type in ['schedule', 'keyword', 'eligible']
          && shortString(request.resource.data.title, 200)
          && shortString(request.resource.data.message, 2000)
          && shortString(request.resource.data.opportunityId, 100)
          && shortString(request.resource.data.sourceUrl, 2000)
          && shortString(request.resource.data.date, 10)
          && request.resource.data.read is bool
          && shortString(request.resource.data.createdAt, 40);
        allow update: if isOwner(uid)
          && changesOnly(['read'])
          && request.resource.data.read is bool;
      }
    }
  }
}
