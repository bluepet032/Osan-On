# Firebase 웹앱 설정값. 브라우저에 포함되는 공개 식별자이며 서비스 계정 키를 넣지 마세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# 수집 상태 페이지를 볼 관리자 Firebase UID(쉼표로 여러 명). 공개 JS에 들어가므로 이메일 대신 UID를 씁니다.
VITE_ADMIN_UIDS=

# 로컬 수집 시 선택 사항. 쉼표로 출처 ID를 나열합니다.
OSANON_SOURCES=

# 정부24 공공서비스(혜택) API 인증키(공공데이터포털 발급). 수집에만 쓰며 사이트에 포함되지 않습니다.
GOV24_API_KEY=
